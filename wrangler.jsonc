{
  // Cloudflare Worker 設定（第二階段：@opennextjs/cloudflare，動態後台）
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dajiang-waterproofing",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      // 自我參照 binding，名稱需與上面的 name 一致（OpenNext 快取用）
      "binding": "WORKER_SELF_REFERENCE",
      "service": "dajiang-waterproofing",
    },
  ],
  "r2_buckets": [
    {
      // OpenNext 的 ISR/data cache（見 open-next.config.ts）
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "dajiang-waterproofing-opennext-cache",
    },
    {
      // 上傳的圖片（施工前後對比照、詢價附件）—— B4 開始用
      "binding": "MEDIA",
      "bucket_name": "dajiang-media",
    },
  ],
  // 部署前記得先建立以上兩個 R2 bucket：
  //   npx wrangler r2 bucket create dajiang-waterproofing-opennext-cache
  //   npx wrangler r2 bucket create dajiang-media
}
